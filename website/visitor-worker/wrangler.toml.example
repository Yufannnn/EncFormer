name = "encformer-visitors"
main = "src/index.js"
compatibility_date = "2026-10-01"

[vars]
# No trailing slash on the hostname. Add your local development origin after a comma if needed.
ALLOWED_ORIGINS = "https://yufannnn.github.io"
SITE_PATH = "/EncFormer/"

[[d1_databases]]
binding = "DB"
database_name = "encformer-visitors"
# Replace with the ID generated by: npx wrangler d1 create encformer-visitors
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"
